# Pulse Chat — environment variables.
#
# Copy this file to `.env` and edit values for your local environment.
# `.env` is gitignored; `.env.example` is committed as the canonical template.
#
# Production deployments inject these through their orchestrator (systemd,
# Kubernetes, Fly.io, etc.) — never commit production secrets to git.

# --- Server ------------------------------------------------------------------
# Address the HTTP/WebSocket server binds to.
# Use ":8080" to listen on all interfaces; "127.0.0.1:8080" for localhost only.
PULSE_SERVER_ADDR=:8080

# Read/write timeouts for HTTP requests. WebSocket upgrade is a special HTTP
# request, so these affect the initial handshake (not the long-lived WS conn).
PULSE_SERVER_READ_TIMEOUT=10s
PULSE_SERVER_WRITE_TIMEOUT=10s

# Maximum number of seconds to wait for in-flight requests to finish during
# graceful shutdown. After this, the server force-closes.
PULSE_SERVER_SHUTDOWN_TIMEOUT=15s

# --- Logging -----------------------------------------------------------------
# Log level: debug | info | warn | error
PULSE_LOG_LEVEL=info

# Log format: text (human-readable, dev) | json (machine-parseable, prod)
PULSE_LOG_FORMAT=text

# --- Phase 2: Postgres (not used yet) ---------------------------------------
# PULSE_POSTGRES_URL=postgres://pulse:pulse@localhost:5432/pulse?sslmode=disable

# --- Phase 3: Redis (not used yet) ------------------------------------------
# PULSE_REDIS_URL=redis://localhost:6379/0

# --- Phase 5: RabbitMQ (not used yet) ---------------------------------------
# PULSE_RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- Phase 5: AI moderation (not used yet) ----------------------------------
# Set whichever LLM provider you choose for moderation.
# PULSE_LLM_API_KEY=...
# PULSE_LLM_MODEL=...
